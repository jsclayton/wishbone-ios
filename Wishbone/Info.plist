<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Wishbone uses the camera to scan the QR code of a login link, and to take your profile photo.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>WishboneAppGroup</key>
	<string>group.$(WISHBONE_BUNDLE_PREFIX)</string>
	<key>WishboneKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(WISHBONE_BUNDLE_PREFIX)</string>
	<key>WishbonePrivacyURL</key>
	<string>$(WISHBONE_PRIVACY_URL)</string>
	<key>WishboneSentryDSN</key>
	<string>$(WISHBONE_SENTRY_DSN)</string>
	<key>WishboneSentryEnvironment</key>
	<string>$(WISHBONE_SENTRY_ENVIRONMENT)</string>
	<key>WishboneSourceURL</key>
	<string>$(WISHBONE_SOURCE_URL)</string>
	<key>WishboneSupportURL</key>
	<string>$(WISHBONE_SUPPORT_URL)</string>
</dict>
</plist>
